{
  "name": "spec-kit-squad-extension",
  "version": "0.1.0",
  "description": "Spec-Kit extension for delegating speckit.implement to Squad",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/ tests/",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest tests/integration",
    "test:contract": "node --experimental-vm-modules node_modules/.bin/jest tests/contract",
    "validate:readiness": "node extension/dist/analyzers/runtime/entrypoints.js readiness",
    "validate:contracts": "node extension/dist/analyzers/runtime/entrypoints.js contracts",
    "analyze:handoff": "node extension/dist/analyzers/runtime/entrypoints.js handoff",
    "analyze:drift": "node extension/dist/analyzers/runtime/entrypoints.js drift"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  }
}
